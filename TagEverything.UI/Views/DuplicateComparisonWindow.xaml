<Window x:Class="TagEverything.UI.Views.DuplicateComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="可能存在重复文件" Height="600" Width="800"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding MatchTypeText}" 
                       Foreground="{Binding MatchTypeBrush}"
                       FontWeight="Bold"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="0,0,0,8"/>
            <TextBlock Text="请核对以下文件信息，确认是否继续导入：" 
                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Existing File -->
                <materialDesign:Card Grid.Column="0" Margin="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="库中已存文件" FontWeight="Bold" FontSize="16" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                        
                        <Image Source="{Binding ExistingThumbnailImage}" Height="150" Margin="0,0,0,16" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        
                        <TextBlock Text="文件名:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ExistingFileName}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding ExistingMetadata}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                   Foreground="{Binding HighlightBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>

                <TextBlock Grid.Column="1" Text="VS" VerticalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="Gray" Margin="16,0"/>

                <!-- Right Column: New File -->
                <materialDesign:Card Grid.Column="2" Margin="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="准备导入文件" FontWeight="Bold" FontSize="16" Margin="0,0,0,16" HorizontalAlignment="Center"/>

                        <Image Source="{Binding NewThumbnailImage}" Height="150" Margin="0,0,0,16" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

                        <TextBlock Text="文件名:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding NewFileName}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding NewMetadata}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                   Foreground="{Binding HighlightBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource MaterialDesignOutlinedButton}" 
                    Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="继续导入" Style="{StaticResource MaterialDesignRaisedButton}" 
                    Click="Import_Click"/>
        </StackPanel>
    </Grid>
</Window>