<Window x:Class="TagEverything.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="设置" Height="300" Width="500"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="应用设置" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="库文件夹路径" FontWeight="Bold" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding LibraryPath}" IsReadOnly="True" 
                         materialDesign:HintAssist.Hint="当前库路径" 
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="更改路径" Click="ChangePath_Click" 
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="关闭" Style="{StaticResource MaterialDesignRaisedButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>