<Window x:Class="TagEverything.UI.Views.FileDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:TagEverything.UI.Converters"
        Title="文件详情" Height="450" Width="400"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Window.Resources>
        <converters:TagColorConverter x:Key="TagColorConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding FilePath}" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MetadataPanel">
                <!-- Metadata items will be added here dynamically -->
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,16">
                <TextBlock Text="标签 (空格或逗号分隔):"/>
                <TextBox x:Name="TagInputBox" KeyDown="TagInputBox_KeyDown" TextChanged="TagInputBox_TextChanged"
                     materialDesign:HintAssist.Hint="输入标签..."/>
            
            <ItemsControl x:Name="TagsList" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Converter={StaticResource TagColorConverter}}" 
                                BorderBrush="{Binding Converter={StaticResource TagColorConverter}}" BorderThickness="1" 
                                CornerRadius="12" Margin="0,0,4,4" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}" Foreground="White" VerticalAlignment="Center"/>
                                <Button CommandParameter="{Binding}" Click="RemoveTag_Click" Style="{StaticResource MaterialDesignToolButton}" 
                                        Width="16" Height="16" Padding="0" Margin="4,0,0,0">
                                    <materialDesign:PackIcon Kind="Close" Width="12" Height="12" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="确认导入" x:Name="ConfirmButton" Click="Confirm_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
