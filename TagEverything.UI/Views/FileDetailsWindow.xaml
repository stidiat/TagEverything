<Window x:Class="TagEverything.UI.Views.FileDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:TagEverything.UI.Converters"
        xmlns:controls="clr-namespace:TagEverything.UI.Controls"
        Title="文件详情" Height="710" Width="560" MinHeight="450" MinWidth="460"
        WindowStartupLocation="CenterOwner" Style="{StaticResource WorkspaceWindow}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <converters:TagColorConverter x:Key="TagColorConverter" />
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding FilePath}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,24"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Height="148" Background="#EEF1F8" CornerRadius="8" Margin="0,0,0,16">
                    <controls:FilePreview Thumbnail="{Binding ImportContext.Thumbnail}" FilePath="{Binding FilePath}"/>
                </Border>
                <StackPanel x:Name="MetadataPanel">
                <!-- Metadata items will be added here dynamically -->
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,16">
                <TextBlock x:Name="SaveStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <ProgressBar x:Name="SaveProgress" Maximum="100" Height="4" Margin="0,6,0,12"/>
                <TextBlock Text="标签 (空格或逗号分隔):"/>
                <TextBox x:Name="TagInputBox" KeyDown="TagInputBox_KeyDown" TextChanged="TagInputBox_TextChanged"
                     materialDesign:HintAssist.Hint="输入标签..."/>

            <ItemsControl x:Name="TagsList" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Converter={StaticResource TagColorConverter}}"
                                BorderBrush="{Binding Converter={StaticResource TagColorConverter}}" BorderThickness="1"
                                CornerRadius="12" Margin="0,0,4,4" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}" Foreground="White" VerticalAlignment="Center"/>
                                <Button CommandParameter="{Binding}" Click="RemoveTag_Click" Style="{StaticResource MaterialDesignToolButton}"
                                        Width="16" Height="16" Padding="0" Margin="4,0,0,0">
                                    <materialDesign:PackIcon Kind="Close" Width="12" Height="12" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="确认导入" x:Name="ConfirmButton" Click="Confirm_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
