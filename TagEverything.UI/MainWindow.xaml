<Window x:Class="TagEverything.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:TagEverything.UI.Converters"
        xmlns:controls="clr-namespace:TagEverything.UI.Controls"
        mc:Ignorable="d"
        Title="TagEverything · 文件库" Icon="/TagEverything;component/Assets/TagEverything.ico" Height="820" Width="1280" MinWidth="1080" MinHeight="600" WindowStartupLocation="CenterScreen" Style="{StaticResource WorkspaceWindow}"
        AllowDrop="True" Drop="Window_Drop"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <converters:TagColorConverter x:Key="TagColorConverter" />
        <converters:SelectionCountToVisibilityConverter x:Key="SelectionCountToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:FileSizeConverter x:Key="FileSizeConverter" />
        <converters:LibraryFilePathConverter x:Key="LibraryFilePathConverter" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,24">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="我的文件库" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="让每一份收藏，都有迹可循。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ClearFiltersCommand}" Content="清空筛选" Style="{StaticResource QuietButton}" Margin="0,0,10,0" Visibility="{Binding HasFilters, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource QuietButton}" ToolTip="刷新文件列表" AutomationProperties.Name="刷新文件列表" Margin="0,0,10,0" Padding="10,0"><materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/></Button>
                    <ToggleButton IsChecked="{Binding IsListView}" Style="{StaticResource MaterialDesignActionToggleButton}" Margin="0,0,12,0" ToolTip="切换卡片 / 列表视图" AutomationProperties.Name="切换文件视图">
                        <materialDesign:PackIcon Kind="ViewGrid" Width="22" Height="22"/>
                        <materialDesign:ToggleButtonAssist.OnContent><materialDesign:PackIcon Kind="ViewList" Width="22" Height="22"/></materialDesign:ToggleButtonAssist.OnContent>
                    </ToggleButton>
                    <Button Click="ImportButton_Click" Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="导入文件" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>
                <Border x:Name="SearchAreaBorder" Grid.Row="1" Grid.ColumnSpan="2" Background="#F5F6FA" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,22,0,0" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ItemsControl Grid.Column="0" MaxWidth="330" ItemsSource="{Binding SearchTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Converter={StaticResource TagColorConverter}}"
                                            BorderBrush="{Binding Converter={StaticResource TagColorConverter}}" BorderThickness="1"
                                            CornerRadius="10" Margin="0,0,4,0" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" Foreground="White" VerticalAlignment="Center" FontSize="11"/>
                                            <Button Command="{Binding DataContext.RemoveSearchTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignToolButton}"
                                                    Width="14" Height="14" Padding="0" Margin="4,0,0,0">
                                                <materialDesign:PackIcon Kind="Close" Width="10" Height="10" Foreground="White"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 materialDesign:HintAssist.Hint="搜索文件名，或输入 #标签筛选"
                                 materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                 BorderThickness="0" Background="Transparent"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="Black" CaretBrush="Black"
                                 VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown"
                                 PreviewMouseLeftButtonUp="SearchBox_PreviewMouseLeftButtonUp">
                        </TextBox>

                        <!-- Tag Suggestion Popup -->
                        <Popup x:Name="TagSuggestionsPopup" PlacementTarget="{Binding ElementName=SearchAreaBorder}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" MaxHeight="300" Width="480"
                               PopupAnimation="Fade">
                            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="10" Margin="0,6,0,0" Padding="12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="2"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                                    <ItemsControl ItemsSource="{Binding FilteredAvailableTags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                        Click="TagSuggestion_Click"
                                                        CommandParameter="{Binding Name}"
                                                        Padding="4,2" Margin="0,0,4,4" Height="Auto">
                                                    <Border Background="{Binding Name, Converter={StaticResource TagColorConverter}}"
                                                            BorderBrush="{Binding Name, Converter={StaticResource TagColorConverter}}" BorderThickness="1"
                                                            CornerRadius="10" Padding="6,2">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <Border Grid.RowSpan="3" Background="#EEF0F7" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="20,28,20,20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <Image Source="/TagEverything;component/Assets/TagEverything.png" Width="42" Height="42" HorizontalAlignment="Left"/>
                    <TextBlock Text="TagEverything" FontSize="19" FontWeight="Bold" Margin="0,14,0,4"/>
                    <TextBlock Text="整理 · 标记 · 发现" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,32,0,16">
                    <Border Background="#E0E4FA" CornerRadius="8" Padding="12">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FolderMultiple" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="文件库" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/></StackPanel>
                    </Border>
                    <TextBlock Text="标签索引" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="12,26,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding AvailableTags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="TagSuggestion_Click" CommandParameter="{Binding Name}" ToolTip="{Binding Name}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Stretch" Padding="10,0" Height="38" Margin="0,0,0,4">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="#" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Margin="0,20,0,0">
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>
                    <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Padding="12,0">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Cog" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="库设置"/></StackPanel>
                    </Button>
                    <TextBlock Text="本地收藏，随时可用" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="12,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Main Content -->
        <Grid Grid.Row="1" Grid.Column="1" Background="Transparent" x:Name="MainGrid"
              PreviewMouseLeftButtonDown="MainScrollViewer_PreviewMouseLeftButtonDown"
              MouseMove="MainScrollViewer_PreviewMouseMove"
              MouseLeftButtonUp="MainScrollViewer_PreviewMouseLeftButtonUp">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding TotalFiles}" Value="0"/><Condition Binding="{Binding IsLoading}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
                <Border Background="#E8EBFA" CornerRadius="24" Width="88" Height="88" HorizontalAlignment="Center" Margin="0,0,0,20"><materialDesign:PackIcon Kind="FolderMultiple" Width="40" Height="40" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="为你的收藏留一个位置" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="拖入文件或点击「导入文件」，开始整理你的文件库。" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="若已添加筛选条件，可移除标签或清空搜索后重试。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
            <Grid Margin="20">
                <Grid>
                    <!-- Card View -->
                    <ListBox ItemsSource="{Binding Files}" SelectionMode="Extended" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="ListBox_SelectionChanged"
                         Tag="{Binding}"
                         Visibility="{Binding IsListView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                         x:Name="FilesListBox">
                    <!-- Bind multiple selections using attached property or code-behind. For simplicity, we can pass SelectedItems in code behind -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VirtualizingTilePanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="4"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <!-- Selection visualization -->
                            <Setter Property="Template">
                                <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="2" CornerRadius="12">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <!-- Match the PrimaryMid color of the Banner -->
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <!-- Hardcode a highly visible semi-transparent color if DynamicResource isn't showing through Card -->
                                            <Setter TargetName="Bd" Property="Background" Value="#E8EBFF"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E9EDF5"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="#DAE0FF"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding RelativeSource={RelativeSource Self}, Path=PlacementTarget.Tag}">
                            <MenuItem Header="编辑标签" Click="EditSelectedTags_Click"
                                      Visibility="{Binding SelectedFilesCount, Converter={StaticResource SelectionCountToVisibilityConverter}, ConverterParameter='Multiple'}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="TagMultiple" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="删除文件" Click="DeleteSelectedFiles_Click"
                                      Visibility="{Binding SelectedFilesCount, Converter={StaticResource SelectionCountToVisibilityConverter}, ConverterParameter='Multiple'}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Delete" Foreground="Red" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- This border sits BEHIND the card to show selection color clearly -->
                                <Border x:Name="SelectionHighlight" Background="Transparent" CornerRadius="4" Margin="2" />
                                <materialDesign:Card Width="218" MinHeight="236" Margin="3" Padding="12" UniformCornerRadius="10" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Background="White">
                                <materialDesign:Card.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </materialDesign:Card.InputBindings>
                                <materialDesign:Card.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="重新关联缺失文件" Command="{Binding RelinkFileCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Visibility="{Binding SelectedFilesCount, Converter={StaticResource SelectionCountToVisibilityConverter}, ConverterParameter='Single'}"/>
                                        <MenuItem Header="编辑标签" Command="{Binding EditTagsCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Visibility="{Binding SelectedFilesCount, Converter={StaticResource SelectionCountToVisibilityConverter}, ConverterParameter='Single'}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="TagEdit" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="删除文件" Command="{Binding DeleteFileCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Visibility="{Binding SelectedFilesCount, Converter={StaticResource SelectionCountToVisibilityConverter}, ConverterParameter='Single'}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Delete" Foreground="Red" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="编辑标签" Click="EditSelectedTags_Click"
                                                  Visibility="{Binding SelectedFilesCount, Converter={StaticResource SelectionCountToVisibilityConverter}, ConverterParameter='Multiple'}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="TagMultiple" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="删除文件" Command="{Binding DeleteMultipleFilesCommand}" CommandParameter="{Binding Files}"
                                                  Visibility="{Binding SelectedFilesCount, Converter={StaticResource SelectionCountToVisibilityConverter}, ConverterParameter='Multiple'}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="DeleteSweep" Foreground="Red" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </materialDesign:Card.ContextMenu>
                                <StackPanel>
                                    <Border Height="132" Margin="0,0,0,12" Background="#EEF1F8" CornerRadius="8" ClipToBounds="True">
                                        <controls:FilePreview RecordId="{Binding Id}" Revision="{Binding Hash}" Thumbnail="{Binding Thumbnail}" FilePath="{Binding AvailableRelativePath, Converter={StaticResource LibraryFilePathConverter}}"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="大小" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding Size, Converter={StaticResource FileSizeConverter}}" FontSize="12" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="文件类型" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock Text="{Binding FileType, Mode=OneWay}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileType, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0" MaxHeight="44" ClipToBounds="True">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Name, Converter={StaticResource TagColorConverter}}"
                                                        BorderBrush="{Binding Name, Converter={StaticResource TagColorConverter}}" BorderThickness="1"
                                                        CornerRadius="5" Margin="0,0,5,5" Padding="7,3">
                                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="White"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="SelectionHighlight" Property="Background" Value="{StaticResource LineBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                    <!-- List View -->
                    <DataGrid ItemsSource="{Binding Files}" AutoGenerateColumns="False" IsReadOnly="True"
                              Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              SelectionChanged="DataGrid_SelectionChanged"
                              HeadersVisibility="Column" Background="White" BorderThickness="0" RowHeight="52" ColumnHeaderHeight="44" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource LineBrush}" AlternatingRowBackground="#FAFBFE" CanUserAddRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True" x:Name="FilesDataGrid" Tag="{Binding}">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenFileCommand}" CommandParameter="{Binding SelectedItem, ElementName=FilesDataGrid}" />
                        </DataGrid.InputBindings>
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding RelativeSource={RelativeSource Self}, Path=PlacementTarget.Tag}">
                                <MenuItem Header="重新关联缺失文件" Command="{Binding RelinkFileCommand}" CommandParameter="{Binding SelectedFile}"
                                          Visibility="{Binding SelectedFilesCount, Converter={StaticResource SelectionCountToVisibilityConverter}, ConverterParameter='Single'}"/>
                                <MenuItem Header="编辑标签" Command="{Binding EditTagsCommand}" CommandParameter="{Binding SelectedFile}"
                                          Visibility="{Binding SelectedFilesCount, Converter={StaticResource SelectionCountToVisibilityConverter}, ConverterParameter='Single'}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="TagEdit" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="删除文件" Command="{Binding DeleteFileCommand}" CommandParameter="{Binding SelectedFile}"
                                          Visibility="{Binding SelectedFilesCount, Converter={StaticResource SelectionCountToVisibilityConverter}, ConverterParameter='Single'}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="Delete" Foreground="Red" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="编辑标签" Click="EditSelectedTagsDataGrid_Click"
                                          Visibility="{Binding SelectedFilesCount, Converter={StaticResource SelectionCountToVisibilityConverter}, ConverterParameter='Multiple'}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="TagMultiple" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="删除文件" Click="DeleteSelectedFilesDataGrid_Click"
                                          Visibility="{Binding SelectedFilesCount, Converter={StaticResource SelectionCountToVisibilityConverter}, ConverterParameter='Multiple'}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="DeleteSweep" Foreground="Red" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件名" Binding="{Binding DisplayName, Mode=OneWay}" SortMemberPath="OriginalName" Width="3*" />
                            <DataGridTextColumn Header="大小" Binding="{Binding Size, Converter={StaticResource FileSizeConverter}}" Width="1.1*" SortMemberPath="Size"/>
                            <DataGridTextColumn Header="文件类型" Binding="{Binding FileType, Mode=OneWay}" Width="1*" SortMemberPath="FileType"/>
                            <DataGridTemplateColumn Header="标签" Width="4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding Name, Converter={StaticResource TagColorConverter}}"
                                                            BorderBrush="{Binding Name, Converter={StaticResource TagColorConverter}}" BorderThickness="1"
                                                            CornerRadius="4" Margin="0,0,4,0" Padding="4,2">
                                                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="White"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="创建时间" Binding="{Binding FileCreationTime, StringFormat=\{0:g\}}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                        <Rectangle x:Name="SelectionBox" Fill="#400078D7" Stroke="#FF0078D7" StrokeThickness="1" Visibility="Collapsed"/>
                    </Canvas>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Grid.Column="1" Background="White" BorderThickness="0,1,0,0" BorderBrush="{StaticResource LineBrush}" Padding="24,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Grid.ColumnSpan="3" Margin="0,0,0,10" Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding ImportStatus}" TextTrimming="CharacterEllipsis"/><ProgressBar Value="{Binding ImportProgress}" Maximum="100" Height="4" Margin="0,8,12,0"/></StackPanel>
                    <Button Grid.Column="1" Content="取消队列" Click="CancelImport_Click" Style="{StaticResource QuietButton}"/>
                </Grid>
                <Button Grid.Row="1" Content="{Binding UntrackedFilesCount, StringFormat=待入库：{0}}" HorizontalAlignment="Left" Click="ImportUntracked_Click" ToolTip="逐个确认，将外部新增文件原地纳管，不复制源文件。">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding UntrackedFilesCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}" Style="{StaticResource QuietButton}" Padding="14,4"/>
                    <TextBlock Text="{Binding PageStatus}" Margin="16,0" VerticalAlignment="Center"/>
                    <Button Content="下一页" Command="{Binding NextPageCommand}" Style="{StaticResource QuietButton}" Padding="14,4"/>
                </StackPanel>
                <Button Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Content="{Binding FailedImportsCount, StringFormat=重试失败：{0}}" Click="RetryImports_Click" ToolTip="{Binding ImportFailures}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding FailedImportsCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
            </Grid>        </Border>

        <ProgressBar Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom" Height="3" IsIndeterminate="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{StaticResource AccentBrush}"/>
        <!-- Drop Overlay -->
        <Border x:Name="DropOverlay" Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Background="#E64F5ED9" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="松开以导入文件" Foreground="White" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
