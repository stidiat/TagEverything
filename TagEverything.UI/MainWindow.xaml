<Window x:Class="TagEverything.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:TagEverything.UI.Converters"
        mc:Ignorable="d"
        Title="TagEverything - 文件管理" Height="600" Width="1000"
        AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <converters:TagColorConverter x:Key="TagColorConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:SelectionCountToVisibilityConverter x:Key="SelectionCountToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="16">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FolderMultiple" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Tag Everything" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" Command="{Binding OpenSettingsCommand}" Style="{StaticResource MaterialDesignToolButton}" Margin="10,0,0,0" ToolTip="设置">
                    <materialDesign:PackIcon Kind="Cog" Width="24" Height="24" Foreground="White"/>
                </Button>

                <Button DockPanel.Dock="Right" Content="导入文件" Command="{Binding ImportCommand}" Click="ImportButton_Click" Margin="10,0,0,0"/>

                <TextBox DockPanel.Dock="Right" Width="300" HorizontalAlignment="Right"
                         materialDesign:HintAssist.Hint="搜索 (支持 #标签 文件名)"
                         materialDesign:TextFieldAssist.HasFilledTextField="True"
                         materialDesign:TextFieldAssist.TextFieldCornerRadius="4"
                         materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                         Background="#80FFFFFF" Padding="8,6"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="Black" CaretBrush="Black">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </materialDesign:ColorZone>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16" x:Name="MainScrollViewer"
                      PreviewMouseLeftButtonDown="MainScrollViewer_PreviewMouseLeftButtonDown"
                      MouseMove="MainScrollViewer_PreviewMouseMove"
                      MouseLeftButtonUp="MainScrollViewer_PreviewMouseLeftButtonUp">
            <Grid>
                <ListBox ItemsSource="{Binding Files}" SelectionMode="Extended" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ListBox_SelectionChanged"
                         Tag="{Binding}"
                         x:Name="FilesListBox">
                    <!-- Bind multiple selections using attached property or code-behind. For simplicity, we can pass SelectedItems in code behind -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="4"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <!-- Selection visualization -->
                            <Setter Property="Template">
                                <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <!-- Match the PrimaryMid color of the Banner -->
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                            <!-- Hardcode a highly visible semi-transparent color if DynamicResource isn't showing through Card -->
                                            <Setter TargetName="Bd" Property="Background" Value="#40673AB7"/> 
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#10000000"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="#60673AB7"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding RelativeSource={RelativeSource Self}, Path=PlacementTarget.Tag}">
                            <MenuItem Header="删除选中的文件" Click="DeleteSelectedFiles_Click"
                                      Visibility="{Binding SelectedFilesCount, Converter={StaticResource SelectionCountToVisibilityConverter}, ConverterParameter='Multiple'}">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Delete" Foreground="Red" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- This border sits BEHIND the card to show selection color clearly -->
                                <Border x:Name="SelectionHighlight" Background="Transparent" CornerRadius="4" Margin="2" />
                                <materialDesign:Card Width="200" Margin="4" Padding="8" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Background="Transparent">
                                <materialDesign:Card.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </materialDesign:Card.InputBindings>
                                <materialDesign:Card.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="编辑标签" Command="{Binding EditTagsCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Visibility="{Binding SelectedFilesCount, Converter={StaticResource SelectionCountToVisibilityConverter}, ConverterParameter='Single'}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="TagEdit" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="删除文件" Command="{Binding DeleteFileCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Visibility="{Binding SelectedFilesCount, Converter={StaticResource SelectionCountToVisibilityConverter}, ConverterParameter='Single'}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Delete" Foreground="Red" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </materialDesign:Card.ContextMenu>
                                <StackPanel>
                                    <Border Height="100" Margin="0,0,0,10" Background="{DynamicResource PrimaryHueLightBrush}" CornerRadius="4">
                                        <Grid>
                                            <materialDesign:PackIcon Kind="File" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}" Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Visible}"/>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding OriginalName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalName}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Size}" FontSize="11" Opacity="0.7"/>
                                    
                                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Name, Converter={StaticResource TagColorConverter}}" 
                                                        BorderBrush="{Binding Name, Converter={StaticResource TagColorConverter}}" BorderThickness="1"
                                                        CornerRadius="4" Margin="0,0,4,4" Padding="4,2">
                                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="White"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </materialDesign:Card>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="SelectionHighlight" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                    <Rectangle x:Name="SelectionBox" Fill="#400078D7" Stroke="#FF0078D7" StrokeThickness="1" Visibility="Collapsed"/>
                </Canvas>
            </Grid>
        </ScrollViewer>
        
        <!-- Drop Overlay -->
        <Border x:Name="DropOverlay" Grid.Row="1" Background="#80000000" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="松开以导入文件" Foreground="White" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
